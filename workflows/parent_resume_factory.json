{"id": "LINxkdqwCawEDJdw", "name": "Resume God - Parent Orchestrator", "nodes": [{"parameters": {"httpMethod": "POST", "path": "resume-god", "responseMode": "responseNode"}, "id": "Webhook", "name": "Webhook Trigger", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [200, 240]}, {"parameters": {"jsCode": "const body = $json.body || $json;\nconst fallbackId = `run_${Date.now()}_${Math.floor(Math.random() * 1e9)}`;\nconst requestId = body.request_id || fallbackId;\nconst jdText = body.job_description_text || '';\nconst company = (body.company_name || 'target_company')\n  .toLowerCase()\n  .replace(/[^a-z0-9]+/g, '_')\n  .replace(/^_|_$/g, '');\n\nreturn [{\n  json: {\n    request_id: requestId,\n    run_dir: `/data/runs/${requestId}`,\n    company_slug: company || 'target_company',\n    job_description_text: jdText,\n    loop_cycle: 1,\n    best_score: 0,\n  },\n}];"}, "id": "RunMeta", "name": "Set Run Metadata", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [430, 240]}, {"parameters": {"command": "mkdir -p {{$json.run_dir}} && printf '%s' {{$json.job_description_text}} > {{$json.run_dir}}/job_description_raw.txt"}, "id": "MakeWorkspace", "name": "Build Run Workspace", "type": "n8n-nodes-base.executeCommand", "typeVersion": 1, "position": [670, 240]}, {"parameters": {"workflowId": "qZP98DlxDe48iLef", "options": {}}, "id": "JDParser", "name": "JD Parser Agent", "type": "n8n-nodes-base.executeWorkflow", "typeVersion": 1, "position": [900, 120]}, {"parameters": {"workflowId": "43iQXCFX9nKGkMoI", "options": {}}, "id": "Evidence", "name": "Candidate Evidence Agent", "type": "n8n-nodes-base.executeWorkflow", "typeVersion": 1, "position": [1130, 120]}, {"parameters": {"workflowId": "M23iRubNFm4yDcwp", "options": {}}, "id": "Author", "name": "Resume Strategist Agent", "type": "n8n-nodes-base.executeWorkflow", "typeVersion": 1, "position": [1360, 120]}, {"parameters": {"workflowId": "zv2Ab3tZ5P2WayE8", "options": {}}, "id": "Render", "name": "LaTeX Renderer + Compiler", "type": "n8n-nodes-base.executeWorkflow", "typeVersion": 1, "position": [1590, 120]}, {"parameters": {"workflowId": "1PYpEsE2HRqR7Rt4", "options": {}}, "id": "Review", "name": "Gemini ATS Reviewer", "type": "n8n-nodes-base.executeWorkflow", "typeVersion": 1, "position": [1820, 120]}, {"parameters": {"jsCode": "const fs = require('fs');\nconst path = `${$json.run_dir}/review_feedback_cycle_${$json.loop_cycle}.json`;\nlet review = {};\ntry { review = JSON.parse(fs.readFileSync(path, 'utf8')); } catch {}\nconst score = Number(review.ats_score || 0);\nconst cycle = Number($json.loop_cycle || 1);\nconst pass = score >= 90;\nconst canRetry = cycle < 3;\nconst best = Math.max(Number($json.best_score || 0), score);\nreturn [{ json: { ...$json, ats_score: score, pass, canRetry, best_score: best, loop_cycle_next: cycle + 1, final_pdf: `${$json.run_dir}/resume_god_${$json.company_slug}.pdf` } }];"}, "id": "LoopControl", "name": "Loop Controller", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [2050, 120]}, {"parameters": {"conditions": {"boolean": [{"value1": "={{$json.pass}}", "value2": true}]}}, "id": "IfPass", "name": "ATS >= 90?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [2280, 120]}, {"parameters": {"conditions": {"boolean": [{"value1": "={{$json.canRetry}}", "value2": true}]}}, "id": "IfRetry", "name": "Retry Remaining?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [2510, 280]}, {"parameters": {"jsCode": "return [{ json: { ...$json, loop_cycle: $json.loop_cycle_next } }];"}, "id": "BumpCycle", "name": "Increment Cycle", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [2740, 280]}, {"parameters": {"respondWith": "json", "responseBody": "={{ { request_id: $json.request_id, status: $json.pass ? 'passed' : 'max_cycles_reached', ats_score: $json.ats_score, best_score: $json.best_score, final_pdf: $json.final_pdf } }}"}, "id": "Respond", "name": "Respond to Webhook", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1, "position": [2740, 80]}], "connections": {"Webhook Trigger": {"main": [[{"node": "Set Run Metadata", "type": "main", "index": 0}]]}, "Set Run Metadata": {"main": [[{"node": "Build Run Workspace", "type": "main", "index": 0}]]}, "Build Run Workspace": {"main": [[{"node": "JD Parser Agent", "type": "main", "index": 0}]]}, "JD Parser Agent": {"main": [[{"node": "Candidate Evidence Agent", "type": "main", "index": 0}]]}, "Candidate Evidence Agent": {"main": [[{"node": "Resume Strategist Agent", "type": "main", "index": 0}]]}, "Resume Strategist Agent": {"main": [[{"node": "LaTeX Renderer + Compiler", "type": "main", "index": 0}]]}, "LaTeX Renderer + Compiler": {"main": [[{"node": "Gemini ATS Reviewer", "type": "main", "index": 0}]]}, "Gemini ATS Reviewer": {"main": [[{"node": "Loop Controller", "type": "main", "index": 0}]]}, "Loop Controller": {"main": [[{"node": "ATS >= 90?", "type": "main", "index": 0}]]}, "ATS >= 90?": {"main": [[{"node": "Respond to Webhook", "type": "main", "index": 0}], [{"node": "Retry Remaining?", "type": "main", "index": 0}]]}, "Retry Remaining?": {"main": [[{"node": "Increment Cycle", "type": "main", "index": 0}], [{"node": "Respond to Webhook", "type": "main", "index": 0}]]}, "Increment Cycle": {"main": [[{"node": "Resume Strategist Agent", "type": "main", "index": 0}]]}}}
